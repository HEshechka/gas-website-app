# App settings
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# PostgreSQL settings used by docker-compose
POSTGRES_DB=gas_website
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Full database connection string used by the app
# Example for local Docker Postgres:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gas_website

# Optional: if you need a public/browser-facing value in the app
# NEXT_PUBLIC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gas_website

# GitHub Actions / deploy settings
# These values are usually set in GitHub repository Variables/Secrets and are not needed in local .env
# PORT=3000
# NODE_ENV=production
# POSTGRES_DB=gas_website
# POSTGRES_USER=postgres
# SSH_HOST=
# SSH_USER=
# SSH_PORT=22
# SSH_PRIVATE_KEY=
# DEPLOY_PATH=/var/www/gas-website-app
